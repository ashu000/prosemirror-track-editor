{
  "name": "prosemirror-track-editor",
  "version": "0.1.0",
  "description": "A headless-first React editor with track-changes (insertion/deletion marks), phrase navigation, and a clean ref API.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "dev": "concurrently \"vite\" \"ts-node demo/server/index.ts\"",
    "build": "vite build && tsc --emitDeclarationOnly",
    "test": "vitest run",
    "lint": "eslint src --ext .ts,.tsx",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17",
    "prosemirror-state": ">=1",
    "prosemirror-view": ">=1",
    "prosemirror-model": ">=1",
    "prosemirror-schema-basic": ">=1",
    "prosemirror-history": ">=1",
    "prosemirror-keymap": ">=1",
    "prosemirror-commands": ">=1"
  },
  "dependencies": {
    "@handlewithcare/prosemirror-suggest-changes": "*",
    "styled-components": "^5.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/styled-components": "^5.1.0",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.0.0",
    "express": "^4.18.0",
    "cors": "^2.8.5",
    "@types/express": "^4.17.0",
    "@types/cors": "^2.8.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.0.0",
    "vitest": "^1.0.0"
  },
  "keywords": ["prosemirror", "track-changes", "rich-text-editor", "react", "diff", "suggest-changes"],
  "license": "MIT"
}
